# ===================================================
# INVOKS Backend Environment Configuration Template
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env
# ===================================================

# Application Environment & Server
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
APP_URL=http://localhost:5000

# CORS Configuration (pisahkan dengan koma jika multiple origins, gunakan * untuk allow all)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=invoks_db
DB_CONNECTION_LIMIT=10

# JWT Authentication
# PENTING: Ganti dengan secret key yang acak & kuat untuk production (minimal 32-64 karakter)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Initial Admin Seeder (digunakan oleh: npm run db:seed)
ADMIN_NAME="Administrator INVOKS"
ADMIN_EMAIL=admin@invoks.com
ADMIN_PASSWORD=Admin123!

# File Upload / Media Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
