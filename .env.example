# ===================================================
# INVOKS Backend Environment Configuration Template
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env
# ===================================================

# Application Environment & Server
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
APP_URL=http://localhost:5000

# CORS Configuration (pisahkan dengan koma jika multiple origins, gunakan * untuk allow all)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=invoks_db
DB_CONNECTION_LIMIT=10

# JWT Authentication
# PENTING: Ganti dengan secret key yang acak & kuat untuk production (minimal 32-64 karakter)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Initial Admin Seeder (digunakan oleh: npm run db:seed)
ADMIN_NAME="Administrator INVOKS"
ADMIN_EMAIL=admin@invoks.com
ADMIN_PASSWORD=Admin123!

# File Upload / Media Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=1

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Background Reminder Job Configuration (Tahap 07)
REMINDER_JOB_INTERVAL_MS=900000
REMINDER_DUE_SOON_MINUTES=30
REMINDER_JOB_ENABLED=true

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=16_karakter_app_password
SMTP_FROM="INVOKS Vokasi UB <emailkamu@gmail.com>"

GEMINI_API_KEY=isi_key_dari_google_ai_studio
GEMINI_MODEL=isi_nama_model_flash